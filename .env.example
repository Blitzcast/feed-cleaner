# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_BUCKET=bucket_name
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# Cloudflare: used by wrangler when you deploy from your machine
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# NVIDIA (Phase 2 only). In production set it with `npx wrangler secret put NVIDIA_API_KEY`;
# for `wrangler dev` put it in site/.dev.vars. Workers never read this file.
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
NVIDIA_MODEL=your-model-name
