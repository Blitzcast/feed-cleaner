# Copy to .env and fill in. .env is gitignored.
# Used by wrangler when you deploy from your machine.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Phase 2 only. In production set it with `npx wrangler secret put NVIDIA_API_KEY`;
# for `wrangler dev` put it in site/.dev.vars. Workers never read this file.
NVIDIA_API_KEY=
