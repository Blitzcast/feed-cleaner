{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feed-cleaner",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // Files in ./public are served directly. Requests that match no file
  // fall through to the Worker in src/index.ts.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
